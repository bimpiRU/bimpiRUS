#!/bin/bash
set -uo pipefail

GLOBAL_START=$(date +%s)

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
YELLOW='\033[0;33m'
MAGENTA='\033[0;35m'
NC='\033[0m'

show_help() {
    echo -e "${GREEN}================================================================================${NC}"
    echo -e "${GREEN}                       bimpiRUS — ПОЛНОЕ РУКОВОДСТВО ПО ФЛАГАМ                  ${NC}"
    echo -e "${GREEN}================================================================================${NC}"
    echo -e "Использование: bimpiRUS [ФЛАГ] [ЦЕЛЬ]"
    echo -e ""
    echo -e "Доступные режимы работы:"
    echo -e "  ${CYAN}-sW${NC}          ${RED}БОЕВОЙ РЕЖИМ (W — ВПЕРЕД / ATTACK)${NC}"
    echo -e "               (Сбор поддоменов -> Zero Trust скоринг -> Авто-атака целей Nmap/Nikto)"
    echo -e ""
    echo -e "  ${CYAN}-sQ${NC}          ${BLUE}ТИХИЙ РАЗВЕДЫВАТЕЛЬНЫЙ РЕЖИМ (Q — ТИХО / QUIET)${NC}"
    echo -e "               (Сбор поддоменов -> Картирование WAF/Bypass -> Определение CMS WhatWeb)"
    echo -e "               *Без проведения деструктивных атак и сканирования портов*"
    echo -e ""
    echo -e "  ${CYAN}-h, --help${NC}   Показать это справочное меню"
    echo -e ""
    echo -e "Примеры запуска:"
    echo -e "  bimpiRUS -sW foxford.ru   (Запустить полный боевой цикл с атакой)"
    echo -e "  bimpiRUS -sQ foxford.ru   (Только тихо собрать карту инфраструктуры через Tor)"
    echo -e "${GREEN}================================================================================${NC}"
    exit 0
}

if [ $# -eq 0 ]; then show_help; fi

MODE=""
TARGET=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) show_help ;;
        -sW) MODE="sW"; TARGET="$2"; shift 2 ;;
        -sQ) MODE="sQ"; TARGET="$2"; shift 2 ;;
        *) if [ -z "$TARGET" ] && [ -n "$MODE" ]; then TARGET="$1"; fi; shift ;;
    esac
done

if [ -z "$MODE" ] || [ -z "$TARGET" ]; then
    echo -e "${RED}[-][Ошибка] Неверный синтаксис!${NC}"
    echo -e "Используйте: ${YELLOW}bimpiRUS -sW <цель>${NC} / ${YELLOW}bimpiRUS -sQ <цель>${NC} или ${YELLOW}bimpiRUS -h${NC}"
    exit 1
fi

echo -e "${BLUE}[*] Запуск Core-Оркестратора bimpiRUS против: ${TARGET}...${NC}"
if [ "$MODE" == "sW" ]; then
    echo -e "${RED}[*] Контур: БОЕВОЙ РЕЖИМ (-sW) | Full-Auto Tor | Контроль зависаний.${NC}"
else
    echo -e "${BLUE}[*] Контур: ТИХИЙ РЕЖИМ (-sQ) | Картирование сети через Tor | Без сканирования портов.${NC}"
fi

# --- УСТАНОВКА ЗАВИСИМОСТЕЙ ---
echo -e "${YELLOW}[*] Проверка зависимостей...${NC}"
REQUIRED_APPS=("tor" "proxychains4" "nmap" "nikto" "host" "curl" "whatweb" "unzip" "wget" "netcat-openbsd")
MISSING_APPS=()
for app in "${REQUIRED_APPS[@]}"; do
    if ! command -v "$app" &> /dev/null; then
        if [ "$app" == "proxychains4" ] && command -v proxychains &> /dev/null; then continue; fi
        if [ "$app" == "netcat-openbsd" ] && command -v nc &> /dev/null; then continue; fi
        MISSING_APPS+=("$app")
    fi
done

if [ ${#MISSING_APPS[@]} -gt 0 ]; then
    echo -e "${YELLOW}[!] Установка недостающих пакетов...${NC}"
    sudo apt update -y >/dev/null 2>&1
    sudo apt install -y "${MISSING_APPS[@]}" >/dev/null 2>&1
fi

if ! command -v subfinder &> /dev/null; then
    echo -e "${YELLOW}[!] Установка subfinder с GitHub...${NC}"
    SUB_URL=$(curl -s https://api.github.com/repos/projectdiscovery/subfinder/releases/latest | grep "browser_download_url.*linux_amd64.zip" | cut -d '"' -f 4)
    if [ -n "$SUB_URL" ]; then
        wget -q "$SUB_URL" -O /tmp/subfinder.zip
        unzip -q /tmp/subfinder.zip -d /tmp/
        sudo mv /tmp/subfinder /usr/local/bin/
        sudo chmod +x /usr/local/bin/subfinder
        rm -f /tmp/subfinder.zip
    fi
fi

# --- АВТОНАСТРОЙКА TOR ---
echo -e "${YELLOW}[*] Проверка конфигурации Tor...${NC}"
TORRC="/etc/tor/torrc"
NEED_RESTART=0

# Проверяем и добавляем ControlPort
if ! grep -q "^ControlPort 9051" "$TORRC" 2>/dev/null; then
    echo -e "${YELLOW}[!] Включение ControlPort 9051 в Tor...${NC}"
    echo "ControlPort 9051" | sudo tee -a "$TORRC" >/dev/null
    NEED_RESTART=1
fi

# Проверяем и отключаем авторизацию по куки (чтобы скрипт мог менять IP без пароля)
if ! grep -q "^CookieAuthentication 0" "$TORRC" 2>/dev/null; then
    echo "CookieAuthentication 0" | sudo tee -a "$TORRC" >/dev/null
    NEED_RESTART=1
fi

if [ $NEED_RESTART -eq 1 ]; then
    echo -e "${YELLOW}[*] Перезапуск Tor для применения настроек...${NC}"
    sudo systemctl restart tor 2>/dev/null || sudo service tor restart 2>/dev/null || true
    sleep 3
fi

# --- ЗАПУСК И ПРОВЕРКА TOR ---
if ! pgrep -x "tor" > /dev/null; then
    echo -e "${YELLOW}[*] Запуск службы Tor...${NC}"
    sudo systemctl start tor 2>/dev/null || sudo service tor start 2>/dev/null || (sudo tor > /dev/null 2>&1 &)
fi

echo -n -e "${YELLOW}[*] Ожидание подключения Tor (порт 9050)${NC}"
TOR_READY=0
for i in {1..15}; do
    if nc -z -w 1 127.0.0.1 9050 2>/dev/null; then
        TOR_READY=1
        break
    fi
    echo -n "."
    sleep 2
done
echo ""

if [ $TOR_READY -eq 0 ]; then
    echo -e "${RED}[-][Ошибка] Tor не запустился.${NC}"
    exit 1
fi
echo -e "${GREEN}[+] Tor успешно запущен.${NC}"

PC_CMD="proxychains4"
command -v proxychains4 &> /dev/null || PC_CMD="proxychains"

# --- УМНАЯ ФУНКЦИЯ РОТАЦИИ IP ---
rotate_tor_ip() {
    echo -e "${YELLOW}  [🔄] Запрос новой Tor-ноды...${NC}"
    OLD_IP=$(curl -s --socks5 127.0.0.1:9050 https://api.ipify.org 2>/dev/null || echo "unknown")
    
    # Отправляем сигнал NEWNYM (Новая личность)
    echo -e 'AUTHENTICATE ""\nSIGNAL NEWNYM\nQUIT' | nc -w 1 127.0.0.1 9051 &>/dev/null
    
    # Ждем, пока IP изменится (максимум 10 секунд)
    for i in {1..5}; do
        sleep 2
        NEW_IP=$(curl -s --socks5 127.0.0.1:9050 https://api.ipify.org 2>/dev/null || echo "unknown")
        if [ "$NEW_IP" != "$OLD_IP" ] && [ "$NEW_IP" != "unknown" ]; then
            echo -e "${GREEN}  [+] IP успешно изменен: $OLD_IP -> $NEW_IP${NC}"
            return 0
        fi
    done
    echo -e "${YELLOW}  [!] Не удалось сменить IP (Tor работает медленно).${NC}"
}

draw_status() {
    local percent=$1; local current=$2; local total=$3; local start_time=$4; local cmd_info=$5
    local now=$(date +%s); local elapsed=$((now - start_time)); local eta_str="0s"
    
    if [ $current -gt 0 ] && [ $elapsed -gt 0 ]; then
        local remaining_seconds=$(( (total - current) * elapsed / current ))
        if [ $remaining_seconds -gt 0 ]; then eta_str="${remaining_seconds}s"; fi
    fi
    
    local completed=$((percent / 5))
    local remaining=$((20 - completed))
    local progress_bar=$(printf "%-${completed}s" | tr ' ' '=')
    local empty_bar=$(printf "%-${remaining}s" | tr ' ' '.')
    
    printf "\r\033[K${CYAN}[${progress_bar}${empty_bar}] %3d%% ${MAGENTA}Анализ: %-30s${NC}" "$percent" "${cmd_info:0:30}"
}

echo -e "\n${YELLOW}[*] Шаг 1: Сканирование инфраструктуры и оценка целей...${NC}"
MAIN_IP=$(host "$TARGET" | grep -m1 "has address" | awk '{print $4}' || true)
if [ -z "$MAIN_IP" ]; then
    echo -e "${RED}[-][Ошибка] Не удалось разрешить IP для $TARGET.${NC}"
    exit 1
fi
BASE_SUBNET=$(echo "$MAIN_IP" | cut -d'.' -f1-3)

raw_subs="$TARGET"
if command -v subfinder &> /dev/null; then
    echo -e "${YELLOW}[*] Поиск поддоменов через subfinder...${NC}"
    sub_out=$(timeout 120 subfinder -d "$TARGET" -silent 2>/dev/null || true)
    if [ -n "$sub_out" ]; then
        raw_subs="${raw_subs}"$'\n'"${sub_out}"
    fi
fi

readarray -t subdomains < <(echo "$raw_subs" | sort -u)
TOTAL_SUBS=${#subdomains[@]}

TARGET_HOSTS=()
TARGET_IPS=()
REPORT_PROFITABLE=""
REPORT_ZERO_TRUST=""
REPORT_WEB_TECH=""
REPORT_VULNS=""

STAGE_START=$(date +%s)
for i in "${!subdomains[@]}"; do
    sub="${subdomains[$i]}"
    [ -z "$sub" ] && continue
    
    CURRENT_TASK=$((i + 1))
    PERCENT=$(( CURRENT_TASK * 100 / TOTAL_SUBS ))
    
    draw_status "$PERCENT" "$CURRENT_TASK" "$TOTAL_SUBS" "$STAGE_START" "Чек: $sub"
    
    SUB_IP=$(host -W 1 "$sub" | grep -m1 "has address" | awk '{print $4}' || true)
    
    if [ -n "$SUB_IP" ]; then
        if echo "$SUB_IP" | grep -qE "^(127\.|10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[0-1])\.)"; then continue; fi

        RETRIES=3
        is_blocked="Нет"
        web_headers=""
        http_status=""
        
        for ((r=1; r<=RETRIES; r++)); do
            web_headers=$($PC_CMD curl -k -s -I -L -m 10 "https://$sub" 2>/dev/null || $PC_CMD curl -k -s -I -L -m 10 "http://$sub" 2>/dev/null || true)
            http_status=$(echo "$web_headers" | grep -i "^HTTP/" | tail -1 | awk '{print $2}' || true)
            
            if [[ "$http_status" =~ ^(403|429|503)$ ]] || [ -z "$http_status" ]; then
                if [ $r -lt $RETRIES ]; then
                    rotate_tor_ip
                else
                    is_blocked="Да"
                fi
            else
                break
            fi
        done

        is_zerotrust="Нет"
        if echo "$web_headers" | grep -qiE "cloudflare-access|cfp-cookie|oauth|sso|identity|beyondcorp|okta|keycloak|login\.|auth0"; then
            is_zerotrust="Да"
        fi

        if [ "$is_zerotrust" == "Да" ]; then
            REPORT_ZERO_TRUST="${REPORT_ZERO_TRUST}\n  [🔒 ZERO TRUST] Хост: $sub -> IP: $SUB_IP (Авторизация)"
        elif [ "$is_blocked" == "Да" ]; then
            REPORT_ZERO_TRUST="${REPORT_ZERO_TRUST}\n  [🛡️ WAF/TOR BLOCK] Хост: $sub -> IP: $SUB_IP (Статус: $http_status)"
        else
            if [[ "$SUB_IP" != "$BASE_SUBNET".* ]]; then type_label="🔥 КРИТИЧЕСКИЙ BYPASS"; else type_label="📌 ГОЛЫЙ УЗЕЛ"; fi
            
            printf "\r\033[K[${type_label}] Хост: %-35s -> IP: %-15s\n" "$sub" "$SUB_IP"
            
            TARGET_HOSTS+=("$sub")
            TARGET_IPS+=("$SUB_IP")
            REPORT_PROFITABLE="${REPORT_PROFITABLE}\n  [$type_label] $sub ($SUB_IP)"
            
            if [ "$MODE" == "sQ" ]; then
                w_out=$($PC_CMD whatweb --max-threads=4 "$sub" 2>/dev/null | grep -oP 'HTTPServer\[.*?\]|Title\[.*?\]|CMS\[.*?\]' | tr '\n' ' ' || true)
                if [ -n "$w_out" ]; then
                    REPORT_WEB_TECH="${REPORT_WEB_TECH}\n  [🌐 СТЕК] $sub: $w_out"
                fi
            fi
        fi
    fi
done
printf "\r\033[K${GREEN}[+] Фаза сбора инфраструктуры успешно завершена.${NC}\n"

if [ "$MODE" == "sW" ]; then
    TOTAL_ATTACKS=${#TARGET_HOSTS[@]}
    if [ $TOTAL_ATTACKS -eq 0 ]; then
        echo -e "\n${GREEN}[+] Высокорентабельных незащищенных точек не найдено.${NC}"
    else
        echo -e "\n\n${RED}[*] Шаг 2: Атака на рентабельные цели ($TOTAL_ATTACKS хостов)...${NC}"
        echo -e "${YELLOW}--------------------------------------------------------------------------------${NC}"

        for i in "${!TARGET_HOSTS[@]}"; do
            host="${TARGET_HOSTS[$i]}"
            ip="${TARGET_IPS[$i]}"
            
            echo -e "\n${MAGENTA}[⚔️ АТАКА] -> $host [$ip]${NC}"
            
            rotate_tor_ip
            
            echo -e "${BLUE}  [1/2] Быстрый скан портов и баннеров (Nmap)...${NC}"
            nmap_out=$(timeout 60 $PC_CMD nmap -sT -Pn -p 80,443,22,8080 -sV --version-light --max-rtt-timeout 5s --max-retries 2 "$ip" 2>/dev/null || true)
            
            if echo "$nmap_out" | grep -qi "open"; then
                echo -e "${YELLOW}  [+] Nmap нашел открытые порты.${NC}"
                REPORT_VULNS="${REPORT_VULNS}\n  [⚠️ ОТКРЫТ] $host ($ip) — Открыты порты."
                echo "$nmap_out" | grep -iE "^[0-9]+/tcp" | sed 's/^/      /'
            else
                echo -e "${GREEN}  [+] Nmap завершен (порты закрыты или WAF).${NC}"
            fi

            echo -e "${BLUE}  [2/2] Поиск веб-уязвимостей (Nikto)...${NC}"
            nikto_out=$(timeout 120 $PC_CMD nikto -h "https://$host" -Tuning 1,2,3,4 -maxtime 90s -timeout 10 2>/dev/null || true)
            
            if echo "$nikto_out" | grep -qiE "OSVDB|Vulnerability|XSS|Remote|Sensitive"; then
                echo -e "${RED}  [🚨 ВЗЛОМ] Найдены веб-бреши на $host!${NC}"
                REPORT_VULNS="${REPORT_VULNS}\n  [❌ ВЕБ-ДЫРА] $host ($ip) — Критические веб-мисконфиги."
                echo "$nikto_out" | grep -iE "OSVDB|Vulnerability|+ " | head -n 5 | sed 's/^/      /'
            else
                echo -e "${GREEN}  [+] Nikto завершен (дыр не найдено или WAF блокирует).${NC}"
            fi
            echo -e "${YELLOW}--------------------------------------------------------------------------------${NC}"
        done
    fi
fi

GLOBAL_END=$(date +%s)
TOTAL_ELAPSED=$((GLOBAL_END - GLOBAL_START))

echo -e "\n\n${GREEN}================================================================================${NC}"
echo -e "${GREEN}                      bimpiRUS СВОДНЫЙ ТЕКСТОВЫЙ ОТЧЕТ СКАНИРОВАНИЯ             ${NC}"
echo -e "${GREEN}================================================================================${NC}"
echo -e " Исходная цель:       $TARGET"
echo -e " Выбранный режим:     $([ "$MODE" == "sW" ] && echo "Боевой режим (-sW)" || echo "Тихий развед-режим (-sQ)")"
echo -e " Общее время сессии:  ${TOTAL_ELAPSED} сек."
echo -e "--------------------------------------------------------------------------------"
echo -e "${YELLOW}[+] ВЫСОКОРЕНТАБЕЛЬНЫЕ КОНТУРЫ (БЕЗ ZERO TRUST / WAF):${NC}"
if [ -n "$REPORT_PROFITABLE" ]; then echo -e "$REPORT_PROFITABLE"; else echo -e "  [-] Не найдено."; fi

if [ "$MODE" == "sQ" ] && [ -n "$REPORT_WEB_TECH" ]; then
    echo -e "--------------------------------------------------------------------------------"
    echo -e "${MAGENTA}[+] ТЕХНОЛОГИЧЕСКИЙ СТЕК (WHATWEB):${NC}"
    echo -e "$REPORT_WEB_TECH"
fi

echo -e "--------------------------------------------------------------------------------"
echo -e "${CYAN}[+] ПРИКРЫТО ZERO TRUST / SSO / WAF:${NC}"
if [ -n "$REPORT_ZERO_TRUST" ]; then echo -e "$REPORT_ZERO_TRUST"; else echo -e "  [-] Не зафиксировано."; fi

if [ "$MODE" == "sW" ]; then
    echo -e "--------------------------------------------------------------------------------"
    echo -e "${RED}[+] РЕЗУЛЬТАТЫ АВТО-ВЗЛОМА:${NC}"
    if [ -n "$REPORT_VULNS" ]; then echo -e "$REPORT_VULNS"; else echo -e "  ${GREEN}[-] Прямых критических уязвимостей не обнаружено.${NC}"; fi
fi
echo -e "${GREEN}================================================================================${NC}"
