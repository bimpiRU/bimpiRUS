#!/bin/bash
set -uo pipefail

GLOBAL_START=$(date +%s)

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
YELLOW='\033[0;33m'
MAGENTA='\033[0;35m'
NC='\033[0m'

show_help() {
    echo -e "${GREEN}================================================================================${NC}"
    echo -e "${GREEN}                       bimpiRUS — ПОЛНОЕ РУКОВОДСТВО ПО ФЛАГАМ                  ${NC}"
    echo -e "${GREEN}================================================================================${NC}"
    echo -e "Использование: bimpiRUS [ФЛАГ] [ЦЕЛЬ]"
    echo -e ""
    echo -e "Доступные режимы работы:"
    echo -e "  ${CYAN}-sW${NC}          ${RED}БОЕВОЙ РЕЖИМ (W — ВПЕРЕД / ATTACK)${NC}"
    echo -e "               (Сбор поддоменов -> WAF Detect -> Авто-атака Nuclei + Nmap + Metasploit)"
    echo -e ""
    echo -e "  ${CYAN}-sQ${NC}          ${BLUE}ТИХИЙ РАЗВЕДЫВАТЕЛЬНЫЙ РЕЖИМ (Q — ТИХО / QUIET)${NC}"
    echo -e "               (Сбор поддоменов -> Картирование WAF -> Определение CMS WhatWeb)"
    echo -e ""
    echo -e "  ${CYAN}-h, --help${NC}   Показать это справочное меню"
    echo -e "${GREEN}================================================================================${NC}"
    exit 0
}

if [ $# -eq 0 ]; then show_help; fi

MODE=""
TARGET=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) show_help ;;
        -sW) MODE="sW"; TARGET="$2"; shift 2 ;;
        -sQ) MODE="sQ"; TARGET="$2"; shift 2 ;;
        *) if [ -z "$TARGET" ] && [ -n "$MODE" ]; then TARGET="$1"; fi; shift ;;
    esac
done

if [ -z "$MODE" ] || [ -z "$TARGET" ]; then
    echo -e "${RED}[-][Ошибка] Неверный синтаксис!${NC}"
    exit 1
fi

# --- УСТАНОВКА ЗАВИСИМОСТЕЙ ---
echo -e "${YELLOW}[*] Проверка зависимостей...${NC}"
REQUIRED_APPS=("tor" "proxychains4" "nmap" "host" "curl" "whatweb" "unzip" "wget" "netcat-openbsd" "wafw00f" "nuclei" "msfconsole")
MISSING_APPS=()
for app in "${REQUIRED_APPS[@]}"; do
    if ! command -v "$app" &> /dev/null; then
        if [ "$app" == "proxychains4" ] && command -v proxychains &> /dev/null; then continue; fi
        if [ "$app" == "netcat-openbsd" ] && command -v nc &> /dev/null; then continue; fi
        MISSING_APPS+=("$app")
    fi
done

if [ ${#MISSING_APPS[@]} -gt 0 ]; then
    echo -e "${YELLOW}[!] Установка недостающих пакетов...${NC}"
    sudo apt update -y >/dev/null 2>&1
    sudo apt install -y "${MISSING_APPS[@]}" >/dev/null 2>&1
fi

# Установка Metasploit (если нет в apt)
if ! command -v msfconsole &> /dev/null; then
    echo -e "${YELLOW}[!] Metasploit не найден. Пропускаю шаг атаки MSF.${NC}"
    MSF_AVAILABLE=0
else
    MSF_AVAILABLE=1
fi

# --- АВТОНАСТРОЙКА TOR ---
echo -e "${YELLOW}[*] Настройка Tor...${NC}"
TORRC="/etc/tor/torrc"
if ! grep -q "^ControlPort 9051" "$TORRC" 2>/dev/null; then
    echo "ControlPort 9051" | sudo tee -a "$TORRC" >/dev/null
    sudo systemctl restart tor 2>/dev/null || sudo service tor restart 2>/dev/null || true
fi
if ! grep -q "^CookieAuthentication 0" "$TORRC" 2>/dev/null; then
    echo "CookieAuthentication 0" | sudo tee -a "$TORRC" >/dev/null
    sudo systemctl restart tor 2>/dev/null || sudo service tor restart 2>/dev/null || true
fi

# --- ЗАПУСК И ПРОВЕРКА TOR ---
if ! pgrep -x "tor" > /dev/null; then
    sudo systemctl start tor 2>/dev/null || sudo service tor start 2>/dev/null || (sudo tor > /dev/null 2>&1 &)
fi
echo -n -e "${YELLOW}[*] Ожидание Tor${NC}"
for i in {1..15}; do
    if nc -z -w 1 127.0.0.1 9050 2>/dev/null; then break; fi
    echo -n "."
    sleep 2
done
echo ""
echo -e "${GREEN}[+] Tor готов.${NC}"

PC_CMD="proxychains4"
command -v proxychains4 &> /dev/null || PC_CMD="proxychains"

rotate_tor_ip() {
    echo -e "${YELLOW}  [🔄] Смена Tor-ноды...${NC}"
    OLD_IP=$(curl -s --socks5 127.0.0.1:9050 https://api.ipify.org 2>/dev/null || echo "unknown")
    echo -e 'AUTHENTICATE ""\nSIGNAL NEWNYM\nQUIT' | nc -w 1 127.0.0.1 9051 &>/dev/null
    for i in {1..5}; do
        sleep 2
        NEW_IP=$(curl -s --socks5 127.0.0.1:9050 https://api.ipify.org 2>/dev/null || echo "unknown")
        if [ "$NEW_IP" != "$OLD_IP" ] && [ "$NEW_IP" != "unknown" ]; then
            echo -e "${GREEN}  [+] IP изменен: $OLD_IP -> $NEW_IP${NC}"
            return 0
        fi
    done
}

# --- СБОР ИНФРАСТРУКТУРЫ ---
echo -e "\n${YELLOW}[*] Шаг 1: Сбор инфраструктуры...${NC}"
MAIN_IP=$(host "$TARGET" | grep -m1 "has address" | awk '{print $4}' || true)
if [ -z "$MAIN_IP" ]; then echo -e "${RED}[-] Не удалось разрешить IP.${NC}"; exit 1; fi

raw_subs="$TARGET"
if command -v subfinder &> /dev/null; then
    sub_out=$(timeout 120 subfinder -d "$TARGET" -silent 2>/dev/null || true)
    if [ -n "$sub_out" ]; then raw_subs="${raw_subs}"$'\n'"${sub_out}"; fi
fi

readarray -t subdomains < <(echo "$raw_subs" | sort -u)
TOTAL_SUBS=${#subdomains[@]}

TARGET_HOSTS=()
TARGET_IPS=()
REPORT_PROFITABLE=""
REPORT_WAF=""
REPORT_WEB_TECH=""

for i in "${!subdomains[@]}"; do
    sub="${subdomains[$i]}"
    [ -z "$sub" ] && continue
    echo -e "\r${CYAN}[*] Анализ ${sub}...${NC}"
    
    SUB_IP=$(host -W 1 "$sub" | grep -m1 "has address" | awk '{print $4}' || true)
    if [ -z "$SUB_IP" ]; then continue; fi

    # Проверка на локальный IP (настоящий критический байпас)
    if echo "$SUB_IP" | grep -qE "^(127\.|10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[0-1])\.)"; then
        REPORT_PROFITABLE="${REPORT_PROFITABLE}\n  [🔥 ЛОКАЛЬНЫЙ IP / BYPASS] $sub ($SUB_IP)"
        TARGET_HOSTS+=("$sub"); TARGET_IPS+=("$SUB_IP")
        continue
    fi

    # Определение WAF
    waf_out=$($PC_CMD wafw00f -a "https://$sub" 2>/dev/null | grep -i "is behind" | head -n1 || true)
    if [ -n "$waf_out" ]; then
        REPORT_WAF="${REPORT_WAF}\n  [🛡️ WAF] $sub: $waf_out"
        continue
    fi

    # Если WAF нет - цель рентабельна
    REPORT_PROFITABLE="${REPORT_PROFITABLE}\n  [📌 ЦЕЛЬ] $sub ($SUB_IP)"
    TARGET_HOSTS+=("$sub"); TARGET_IPS+=("$SUB_IP")
done

echo -e "\n${GREEN}[+] Сбор инфраструктуры завершен.${NC}"

# --- АТАКА ---
REPORT_VULNS=""
if [ "$MODE" == "sW" ] && [ ${#TARGET_HOSTS[@]} -gt 0 ]; then
    echo -e "\n${RED}[*] Шаг 2: Атака на ${#TARGET_HOSTS[@]} целей...${NC}"
    
    for i in "${!TARGET_HOSTS[@]}"; do
        host="${TARGET_HOSTS[$i]}"
        ip="${TARGET_IPS[$i]}"
        echo -e "\n${MAGENTA}[⚔️] Атака: $host ($ip)${NC}"
        rotate_tor_ip

        # 1. Nmap (правильный парсинг)
        echo -e "${BLUE}  [1/3] Nmap...${NC}"
        nmap_out=$(timeout 60 $PC_CMD nmap -sT -Pn -p 80,443,22,8080 -sV --version-light --max-rtt-timeout 5s "$ip" 2>/dev/null || true)
        
        # Исправленный парсинг: ищем только строки со статусом open, НО НЕ closed/filtered
        open_ports=$(echo "$nmap_out" | grep -E "^[0-9]+/tcp" | grep -vE "closed|filtered" || true)
        
        if [ -n "$open_ports" ]; then
            echo -e "${YELLOW}  [+] Открытые порты:${NC}"
            echo "$open_ports" | sed 's/^/      /'
            REPORT_VULNS="${REPORT_VULNS}\n  [⚠️ NMAP] $host ($ip) — Открыты: $(echo "$open_ports" | awk '{print $1}' | tr '\n' ' ')"
            
            # 2. Metasploit (поиск эксплойтов для найденных сервисов)
            if [ "$MSF_AVAILABLE" -eq 1 ]; then
                echo -e "${BLUE}  [2/3] Metasploit search...${NC}"
                # Извлекаем имя сервиса (например, nginx, OpenSSH) для поиска
                service_names=$(echo "$open_ports" | awk '{print $3}' | sort -u | head -n2)
                for srv in $service_names; do
                    if [ -n "$srv" ] && [ "$srv" != "http" ] && [ "$srv" != "https" ]; then
                        msf_search=$(timeout 30 msfconsole -q -x "search type:exploit platform:* name:$srv; exit" 2>/dev/null | grep -E "exploit/" | head -n2 || true)
                        if [ -n "$msf_search" ]; then
                            echo -e "${RED}  [🚨 MSF] Найдены эксплойты для $srv:${NC}"
                            echo "$msf_search" | sed 's/^/      /'
                            REPORT_VULNS="${REPORT_VULNS}\n  [🚨 MSF] $host — Эксплойты для $srv."
                        fi
                    fi
                done
            fi
        else
            echo -e "${GREEN}  [+] Nmap: открытых портов нет.${NC}"
        fi

        # 3. Nuclei (реальный поиск уязвимостей)
        echo -e "${BLUE}  [3/3] Nuclei...${NC}"
        nuclei_out=$(timeout 120 $PC_CMD nuclei -u "https://$host" -silent -severity critical,high,medium 2>/dev/null || true)
        if [ -n "$nuclei_out" ]; then
            echo -e "${RED}  [🚨 Nuclei] Найдены уязвимости:${NC}"
            echo "$nuclei_out" | head -n5 | sed 's/^/      /'
            REPORT_VULNS="${REPORT_VULNS}\n  [❌ NUCLEI] $host — $(echo "$nuclei_out" | wc -l) findings."
        else
            echo -e "${GREEN}  [+] Nuclei: чисто.${NC}"
        fi
    done
fi

# --- ОТЧЕТ ---
echo -e "\n\n${GREEN}================================================================================${NC}"
echo -e "${GREEN}                      bimpiRUS СВОДНЫЙ ОТЧЕТ                                    ${NC}"
echo -e "${GREEN}================================================================================${NC}"
echo -e " Цель: $TARGET | Время: $(( $(date +%s) - GLOBAL_START )) сек."
echo -e "--------------------------------------------------------------------------------"
echo -e "${YELLOW}[+] РЕНТАБЕЛЬНЫЕ ЦЕЛИ:${NC}"
echo -e "${REPORT_PROFITABLE:-  [-] Нет.}"

echo -e "--------------------------------------------------------------------------------"
echo -e "${CYAN}[+] ЗАЩИЩЕНО WAF:${NC}"
echo -e "${REPORT_WAF:-  [-] Нет.}"

if [ "$MODE" == "sW" ]; then
    echo -e "--------------------------------------------------------------------------------"
    echo -e "${RED}[+] РЕЗУЛЬТАТЫ АТАКИ:${NC}"
    echo -e "${REPORT_VULNS:-  ${GREEN}[-] Уязвимостей не найдено.${NC}}"
fi
echo -e "${GREEN}================================================================================${NC}"
